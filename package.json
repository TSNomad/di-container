{
  "name": "@tsnomad/di-container",
  "version": "0.2.0",
  "description": "Dependency injection container with PHPNomad-style class binding, static inject autowiring, factories and singleton caching, the TypeScript counterpart to PHPNomad's di-container",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsnomad/di-container.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./container": {
      "types": "./dist/Container.d.ts",
      "default": "./dist/Container.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./create-token": {
      "types": "./dist/createToken.d.ts",
      "default": "./dist/createToken.js"
    },
    "./instance-provider": {
      "types": "./dist/InstanceProvider.d.ts",
      "default": "./dist/InstanceProvider.js"
    },
    "./has-bindings": {
      "types": "./dist/HasBindings.d.ts",
      "default": "./dist/HasBindings.js"
    },
    "./can-set-container": {
      "types": "./dist/CanSetContainer.d.ts",
      "default": "./dist/CanSetContainer.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "pretypecheck": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "pretest": "npm run build",
    "test": "node --test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
